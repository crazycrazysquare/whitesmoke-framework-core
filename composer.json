{
    "name": "whitesmoke/core",
    "description": "Whitesmoke Framework core: HTTP, routing, views, sessions, security, validation, database.",
    "type": "library",
    "keywords": [
        "framework",
        "php",
        "whitesmoke"
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Whitesmoke\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Whitesmoke\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --stderr"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
